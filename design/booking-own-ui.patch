 // Слоти дня: лише майбутні (з запасом у годину). Повертає Date[] (моменти початку).
-export function slotsFor(y, m, d) {
+export function slotsFor(y, m, d, live = null) {
+  if (live) return live.filter((i) => i.getFullYear() === y && i.getMonth() === m && i.getDate() === d);
   const dow = new Date(Date.UTC(y, m, d)).getUTCDay();
   if (dow === 0 || dow === 6) return [];
   const min = Date.now() + 60 * 60 * 1000;
   return SLOT_TIMES.map((t) => agencyInstant(y, m, d, +t.slice(0, 2), +t.slice(3))).filter((i) => i.getTime() > min);
 }
 
-export const isBookable = (y, m, d) => slotsFor(y, m, d).length > 0;
+export const isBookable = (y, m, d, live = null) => slotsFor(y, m, d, live).length > 0;
+
+// Живі вільні слоти на місяць (Date[]); при помилці — [], щоб не показувати вигаданий час.
+export async function loadSlots(y, m) {
+  const start = new Date(y, m, 1);
+  const end = new Date(y, m + 1, 1);
+  try {
+    const res = await fetch(`${API}/bookingSlots?start=${start.toISOString()}&end=${end.toISOString()}`);
+    if (!res.ok) throw new Error(res.status);
+    return (await res.json()).slots.map((s) => new Date(s));
+  } catch {
+    return [];
+  }
+}
 
