rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public lead capture — the quick-question modal, the CTA brief, and the
    // booked intro call all write here. Anyone can create (write-only,
    // create-only); no one can read, update or delete from the client.
    // Field set mirrors src/lib/leads.js.
    match /project_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['email', 'name', 'message', 'services', 'budget',
                          'slot', 'timezone', 'source', 'createdAt', 'page'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 320
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() < 64
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.page is string
                    && (!('name' in request.resource.data)
                        || (request.resource.data.name is string
                            && request.resource.data.name.size() < 200))
                    && (!('message' in request.resource.data)
                        || (request.resource.data.message is string
                            && request.resource.data.message.size() < 5000))
                    && (!('services' in request.resource.data)
                        || (request.resource.data.services is list
                            && request.resource.data.services.size() < 20))
                    && (!('budget' in request.resource.data)
                        || (request.resource.data.budget is string
                            && request.resource.data.budget.size() < 64))
                    && (!('slot' in request.resource.data)
                        || (request.resource.data.slot is string
                            && request.resource.data.slot.size() < 64))
                    && (!('timezone' in request.resource.data)
                        || (request.resource.data.timezone is string
                            && request.resource.data.timezone.size() < 64));

      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
